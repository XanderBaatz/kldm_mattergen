#!/bin/bash
set -euo pipefail

# ---------------- LSF CONFIG ----------------
#BSUB -J kldm_plus
#BSUB -q gpuv100
#BSUB -n 4
#BSUB -R "span[hosts=1]"
#BSUB -gpu "num=1:mode=exclusive_process"
#BSUB -R "rusage[mem=8GB]"
#BSUB -W 24:00
#BSUB -o logs/%J.out
#BSUB -e logs/%J.err

# ---------------- SETUP ----------------

cd ~/kldm_mattergen || exit 1

module load python3/3.11.13
module load cuda/12.9.1 || true

# ---------------- ENV VARS ----------------

# PROJECT_ROOT must be in the OS environment for Hydra's oc.env resolver.
export PROJECT_ROOT="$PWD"
export HYDRA_FULL_ERROR=1
export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1

# Job-specific WandB fields that only the shell knows.
export WANDB_NAME="${WANDB_NAME:-kldm_plus_${LSB_JOBID:-local}}"
export WANDB_RUN_GROUP="${WANDB_RUN_GROUP:-${LSB_QUEUE:-gpuv100}_runs}"

# Everything else (DATA_PATH, KLDM_CONFIG, WANDB_API_KEY, WANDB_PROJECT,
# WANDB_MODE, ...) is loaded from .env.local by the Python Settings class.

# ---------------- DIRECTORIES ----------------

mkdir -p logs

# ---------------- DEBUG INFO ----------------

echo "====================================="
echo "KLDM-Plus TRAINING JOB START"
echo "Job ID:  ${LSB_JOBID:-local}"
echo "Host:    $(hostname)"
echo "Date:    $(date)"
echo "Repo:    $(pwd)"
echo "====================================="
nvidia-smi || echo "No GPU visible"
echo "====================================="

# ---------------- TRAIN ----------------

uv run python -m kldm_plus.train \
    --config-name "${KLDM_CONFIG:-kldm_csp}" \
    "$@"

# ---------------- DONE ----------------

echo "Training finished at $(date)"

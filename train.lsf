#!/bin/bash
set -euo pipefail

# ---------------- LSF CONFIG ----------------
#BSUB -J kldm_plus
#BSUB -q gpuv100
#BSUB -n 4
#BSUB -R "span[hosts=1]"
#BSUB -gpu "num=1:mode=exclusive_process"
#BSUB -R "rusage[mem=8GB]"
#BSUB -W 24:00
#BSUB -o %J.out
#BSUB -e %J.err

# ---------------- SETUP ----------------

cd ~/kldm_mattergen || exit 1

module load python3/3.11.13
module load cuda/12.9.1 || true

# ---------------- ENV VARS ----------------

export PROJECT_ROOT="$PWD"
export LOG_PATH="${LOG_PATH:-$HOME/kldm_logs}"
# DATA_PATH: directory containing mp_20/processed (and other datasets).
# Override before submitting if your data lives on a shared filesystem.
# e.g.  DATA_PATH=/work/datasets bsub < train.lsf
export DATA_PATH="${DATA_PATH:-$HOME/kldm_mattergen/data}"
export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1

# Config name: kldm (de-novo) | kldm_csp (CSP)
KLDM_CONFIG="${KLDM_CONFIG:-kldm}"

# WandB
if [ -f "$HOME/.wandb_env" ]; then
    source "$HOME/.wandb_env"
fi
export WANDB_PROJECT="${WANDB_PROJECT:-kldm_plus}"
export WANDB_RUN_GROUP="${WANDB_RUN_GROUP:-v100_runs}"
export WANDB_NAME="${WANDB_NAME:-kldm_plus_${LSB_JOBID:-local}}"
export WANDB__SERVICE_WAIT="${WANDB__SERVICE_WAIT:-300}"
export WANDB_START_METHOD=thread
export WANDB_MODE="${WANDB_MODE:-online}"

# ---------------- DIRECTORIES ----------------

mkdir -p logs "$LOG_PATH"

# ---------------- DEBUG INFO ----------------

echo "====================================="
echo "KLDM-Plus TRAINING JOB START"
echo "Job ID:  ${LSB_JOBID:-local}"
echo "Host:    $(hostname)"
echo "Date:    $(date)"
echo "Repo:    $(pwd)"
echo "Config:  $KLDM_CONFIG"
echo "Log dir: $LOG_PATH"
echo "====================================="
nvidia-smi || echo "No GPU visible"
echo "====================================="
env | grep WANDB || echo "No WANDB env found"
echo "====================================="

# ---------------- TRAIN ----------------

uv run python -m kldm_plus.train \
    --config-name "$KLDM_CONFIG" \
    "$@"

# ---------------- DONE ----------------

echo "Training finished at $(date)"
